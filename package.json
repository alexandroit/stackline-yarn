{
  "name": "@stackline/yarn",
  "installationMethod": "unknown",
  "version": "1.0.2",
  "license": "BSD-2-Clause",
  "preferGlobal": true,
  "description": "📦🐈 Fast, reliable, and secure dependency management.",
  "dependencies": {
    "@zkochan/cmd-shim": "^3.1.0",
    "bytes": "^3.0.0",
    "camelcase": "^4.0.0",
    "chalk": "^2.1.0",
    "cli-table3": "^0.4.0",
    "commander": "^2.9.0",
    "death": "^1.0.0",
    "debug": "^3.0.0",
    "deep-equal": "^1.0.1",
    "detect-indent": "^5.0.0",
    "dnscache": "^1.0.1",
    "glob": "^7.1.1",
    "gunzip-maybe": "^1.4.0",
    "hash-for-dep": "^1.2.3",
    "ini": "^1.3.4",
    "inquirer": "8.2.7",
    "invariant": "^2.2.0",
    "is-builtin-module": "^2.0.0",
    "is-ci": "^1.0.10",
    "is-webpack-bundle": "^1.0.0",
    "js-yaml": "^3.13.1",
    "leven": "^2.0.0",
    "loud-rejection": "^1.2.0",
    "micromatch": "4.0.8",
    "mkdirp": "^0.5.1",
    "node-emoji": "^1.6.1",
    "normalize-url": "4.5.1",
    "npm-logical-tree": "^1.2.1",
    "object-path": "^0.11.2",
    "proper-lockfile": "^2.0.0",
    "puka": "^1.0.0",
    "punycode": "1.4.1",
    "read": "^1.0.7",
    "request": "npm:@cypress/request@4.0.1",
    "request-capture-har": "^1.2.2",
    "rimraf": "^2.5.0",
    "semver": "^5.1.0",
    "ssri": "12.0.0",
    "strip-ansi": "^4.0.0",
    "strip-bom": "^3.0.0",
    "tar-fs": "1.16.6",
    "tar-stream": "1.6.2",
    "uuid": "11.1.1",
    "v8-compile-cache": "^2.0.0",
    "validate-npm-package-license": "^3.0.4",
    "yn": "^2.0.0",
    "minimatch": "3.1.5"
  },
  "devDependencies": {
    "webpack": "5.111.1",
    "babel-loader": "10.1.1",
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-flow": "7.29.7",
    "jest": "30.5.2",
    "babel-jest": "30.5.2",
    "mock-stdin": "1.0.0",
    "temp": "0.9.4",
    "execa": "5.1.1",
    "@babel/plugin-transform-modules-commonjs": "7.29.7"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/stackline-yarn.git"
  },
  "bin": {
    "yarn": "./bin/yarn.js",
    "yarnpkg": "./bin/yarn.js"
  },
  "scripts": {
    "build": "node scripts/build-stackline.cjs",
    "test": "node scripts/run-tests.cjs",
    "test:unit": "node scripts/run-tests.cjs __tests__/lockfile.js __tests__/package-compatibility.js __tests__/normalize-manifest.js __tests__/package-hoister.js __tests__/package-request.js __tests__/package-resolver.js __tests__/rc.js __tests__/registries __tests__/resolvers __tests__/util",
    "test:package": "node scripts/test-package.mjs",
    "test:cli": "node test/stackline.cjs",
    "test:security": "node test/archive-security.cjs"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "testEnvironment": "node",
    "modulePathIgnorePatterns": [
      "__tests__/fixtures/",
      "packages/pkg-tests/pkg-tests-fixtures",
      "dist/"
    ],
    "testPathIgnorePatterns": [
      "__tests__/(fixtures|__mocks__)/",
      "updates/",
      "_(temp|mock|install|init|helpers).js$",
      "packages/pkg-tests",
      "__tests__/__snapshots__/",
      "scripts/",
      "test/"
    ],
    "testRegex": "__tests__/.+\\.js$",
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "testTimeout": 30000,
    "snapshotFormat": {
      "escapeString": true,
      "printBasicPrototype": true
    }
  },
  "homepage": "https://alexandro.net/docs/vanilla/yarn/",
  "bugs": {
    "url": "https://github.com/alexandroit/stackline-yarn/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "bin",
    "lib/cli.js",
    "lib/lockfile.js",
    "lib/build-inventory.json",
    "LICENSE",
    "NOTICE",
    "README.md",
    "UPSTREAM.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "keywords": [
    "stackline",
    "npm-package",
    "yarn",
    "nodejs"
  ]
}
